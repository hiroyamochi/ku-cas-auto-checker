{
  "manifest_version": 3,
  "name": "Radio Button Changer",
  "version": "1.0",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://cas.kumamoto-u.ac.jp/cas/*", "https://uportal.kumamoto-u.ac.jp/*"],
      "js": ["content.js"]
    }
  ]
}